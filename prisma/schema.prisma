generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  EMPLOYEE
  CLIENT
}

enum ServiceStatus {
  SOLICITADO
  ASIGNADO
  EN_CAMINO
  EN_PROGRESO
  COMPLETADO
  CANCELADO
}

model Duo {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?
  members     User[]
  createdAt   DateTime @default(now())
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role
  phone        String?
  duoRole      String?
  duoId        String?
  duo          Duo?     @relation(fields: [duoId], references: [id])
  services     Service[]     @relation("ClientServices")
  assignments  Assignment[]
  createdAt    DateTime @default(now())
}

model Service {
  id            String        @id @default(cuid())
  address       String
  zone          String?
  notes         String?
  scheduledAt   DateTime
  durationHours Float         @default(4.5)
  priceBs       Int           @default(250)
  status        ServiceStatus @default(SOLICITADO)
  clientId      String
  client        User          @relation("ClientServices", fields: [clientId], references: [id])
  assignments   Assignment[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([clientId])
  @@index([status])
  @@index([scheduledAt])
}

model Assignment {
  id         String  @id @default(cuid())
  serviceId  String
  employeeId String
  service    Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  employee   User    @relation(fields: [employeeId], references: [id])

  @@unique([serviceId, employeeId])
  @@index([employeeId])
}
