generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         String
  phone        String?
  duoRole      String?
  duoId        String?
  duo          Duo?      @relation("DuoMembers", fields: [duoId], references: [id])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  clientServices Service[]           @relation("ClientServices")
  assignments    ServiceAssignment[]
  events         ServiceEvent[]

  @@index([role])
  @@index([duoId])
}

model Duo {
  id        String    @id @default(cuid())
  name      String
  notes     String?
  createdAt DateTime  @default(now())
  members   User[]    @relation("DuoMembers")
  services  Service[]
}

model Service {
  id            String   @id @default(cuid())
  clientId      String
  client        User     @relation("ClientServices", fields: [clientId], references: [id])
  address       String
  zone          String
  reference     String?
  notes         String?
  scheduledAt   DateTime
  durationHours Float    @default(4.5)
  priceBs       Int      @default(250)
  status        String   @default("SOLICITADO")
  duoId         String?
  duo           Duo?     @relation(fields: [duoId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  assignments ServiceAssignment[]
  events      ServiceEvent[]

  @@index([clientId])
  @@index([status])
  @@index([scheduledAt])
  @@index([duoId])
}

model ServiceAssignment {
  id         String   @id @default(cuid())
  serviceId  String
  service    Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  employeeId String
  employee   User     @relation(fields: [employeeId], references: [id])
  duoRole    String?
  createdAt  DateTime @default(now())

  @@unique([serviceId, employeeId])
  @@index([employeeId])
}

model ServiceEvent {
  id        String   @id @default(cuid())
  serviceId String
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id])
  message   String
  createdAt DateTime @default(now())

  @@index([serviceId])
}
