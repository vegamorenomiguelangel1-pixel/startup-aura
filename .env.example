# Local and production use the same names.
# Production values go in Cloud Secret Manager (see apphosting.yaml), not in git.
# Web config from Firebase console → Project settings → General → Your apps.
# The API key is public by design. Do not put the service-account private key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# Admin SDK from Firebase console → Project settings → Service accounts → Generate new private key.
# Copy the fields out of that JSON. Do not commit the JSON file.
# Keep the private key in quotes, with newlines written as \n.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=""

# Local emulator only. Leave these unset when using a real Firebase project.
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
